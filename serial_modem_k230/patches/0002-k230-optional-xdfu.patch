+++ b/app/src/sm_at_dfu_stub.c
@@ -0,0 +1,66 @@
+/*
+ * K230 Serial Modem DFU stub.
+ *
+ * SPDX-License-Identifier: LicenseRef-Nordic-5-Clause
+ */
+
+#include <errno.h>
+#include <stdbool.h>
+#include <stddef.h>
+
+#include <zephyr/logging/log.h>
+#include <zephyr/sys/util.h>
+
+#include "sm_at_dfu.h"
+
+LOG_MODULE_REGISTER(sm_dfu_stub, CONFIG_SM_LOG_LEVEL);
+
+bool sm_bootloader_mode_requested;
+bool sm_bootloader_mode_enabled;
+int full_mfw_dfu_segment_type;
+
+int bootloader_mode_request(bool enable)
+{
+	if (enable) {
+		LOG_WRN("XDFU bootloader mode is disabled in this K230 build");
+		return -ENOTSUP;
+	}
+
+	sm_bootloader_mode_requested = false;
+	sm_bootloader_mode_enabled = false;
+
+	return 0;
+}
+
+static int xdfu_disabled(void)
+{
+	LOG_WRN("AT#XDFU commands are disabled in this K230 build");
+	return -ENOTSUP;
+}
+
+int sm_at_handle_xdfu_init(char *buf, size_t len, char *at_cmd)
+{
+	ARG_UNUSED(buf);
+	ARG_UNUSED(len);
+	ARG_UNUSED(at_cmd);
+
+	return xdfu_disabled();
+}
+
+int sm_at_handle_xdfu_write(char *buf, size_t len, char *at_cmd)
+{
+	ARG_UNUSED(buf);
+	ARG_UNUSED(len);
+	ARG_UNUSED(at_cmd);
+
+	return xdfu_disabled();
+}
+
+int sm_at_handle_xdfu_apply(char *buf, size_t len, char *at_cmd)
+{
+	ARG_UNUSED(buf);
+	ARG_UNUSED(len);
+	ARG_UNUSED(at_cmd);
+
+	return xdfu_disabled();
+}
