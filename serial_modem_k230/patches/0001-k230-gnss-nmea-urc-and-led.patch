+#if defined(CONFIG_SM_GNSS_NMEA_URC)
+SM_AT_CMD_CUSTOM(xnmea, "AT#XNMEA", handle_at_gnss_nmea);
+static int handle_at_gnss_nmea(enum at_parser_cmd_type cmd_type, struct at_parser *parser,
+			       uint32_t param_count)
+{
+	uint16_t enable;
+	int err;
+
+	switch (cmd_type) {
+	case AT_PARSER_CMD_TYPE_SET:
+		if (param_count != 2) {
+			return -EINVAL;
+		}
+		err = at_parser_num_get(parser, 1, &enable);
+		if (err || enable > 1) {
+			return -EINVAL;
+		}
+		gnss_nmea_urc_enabled = enable;
+		break;
+
+	case AT_PARSER_CMD_TYPE_READ:
+		rsp_send("\r\n#XNMEA: %d\r\n", gnss_nmea_urc_enabled ? 1 : 0);
+		break;
+
+	case AT_PARSER_CMD_TYPE_TEST:
+		rsp_send("\r\n#XNMEA: (0,1)\r\n");
+		break;
+
+	default:
+		return -EINVAL;
+	}
+
+	return 0;
+}
+#endif
