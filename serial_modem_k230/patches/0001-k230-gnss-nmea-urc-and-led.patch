@@ -340,13 +340,33 @@ endif # SM_MQTTC
 
 if SM_GNSS
 
+config SM_GNSS_NMEA_URC
+	bool "Send GNSS NMEA sentences to the AT host as URCs"
+	default n
+	help
+	  If enabled, GNSS NMEA data is emitted to the active Serial Modem AT
+	  pipe as #XGNSSNMEA unsolicited notifications. This is useful when an
+	  external host such as K230 needs raw NMEA data on the same UART as AT
+	  commands instead of reading Serial Modem debug logs.
+
+config SM_GNSS_NMEA_URC_DEFAULT
+	bool "Enable GNSS NMEA URC output by default"
+	default n
+	depends on SM_GNSS_NMEA_URC
+	help
+	  If enabled, #XGNSSNMEA unsolicited notifications are active when
+	  Serial Modem starts. The host can change this at runtime with
+	  AT#XNMEA=<0|1>.
+
 config SM_GNSS_OUTPUT_NMEA_SATELLITES
 	bool "Output NMEA satellite messages (GSV, GSA)"
-	default y if SM_LOG_LEVEL_DBG
-	depends on SM_LOG_LEVEL_DBG
+	default y if SM_LOG_LEVEL_DBG
+	depends on SM_LOG_LEVEL_DBG || SM_GNSS_NMEA_URC
 	help
 	  If enabled, NMEA messages that pertain to the satellites will be output
-	  along with the other NMEA messages. Those are output in debug logs.
+	  along with the other NMEA messages. When SM_LOG_LEVEL_DBG is enabled
+	  they are output in debug logs. When SM_GNSS_NMEA_URC is enabled they
+	  are output as #XGNSSNMEA URCs on the active AT pipe.
 
