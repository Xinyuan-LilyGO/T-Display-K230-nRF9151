index 432dfb0..c4cbf03 100644
--- a/app/src/main.c
+++ b/app/src/main.c
@@ -18,6 +18,8 @@
 #include "sm_ctrl_pin.h"
 #include "sm_uart_handler.h"
 #include "sm_log.h"
+#include <zephyr/device.h>
+#include <zephyr/drivers/gpio.h>
 
 LOG_MODULE_REGISTER(sm, CONFIG_SM_LOG_LEVEL);
 
@@ -29,5 +31,28 @@ NRF_MODEM_LIB_ON_INIT(lwm2m_init_hook, on_modem_lib_init, NULL);
 NRF_MODEM_LIB_ON_DFU_RES(main_dfu_hook, on_modem_dfu_res, NULL);
 
+#define K230_RUN_LED_NODE DT_ALIAS(k230_run_led)
+
+#if DT_NODE_HAS_STATUS(K230_RUN_LED_NODE, okay)
+static const struct gpio_dt_spec k230_run_led = GPIO_DT_SPEC_GET(K230_RUN_LED_NODE, gpios);
+
+static void k230_run_led_thread(void)
+{
+	if (!gpio_is_ready_dt(&k230_run_led)) {
+		LOG_WRN("K230 run LED GPIO is not ready");
+		return;
+	}
+
+	(void)gpio_pin_configure_dt(&k230_run_led, GPIO_OUTPUT_INACTIVE);
+	while (true) {
+		(void)gpio_pin_set_dt(&k230_run_led, 1);
+		k_msleep(300);
+		(void)gpio_pin_set_dt(&k230_run_led, 0);
+		k_msleep(700);
+	}
+}
+K_THREAD_DEFINE(k230_run_led_tid, 512, k230_run_led_thread, NULL, NULL, NULL, 7, 0, 0);
+#endif
