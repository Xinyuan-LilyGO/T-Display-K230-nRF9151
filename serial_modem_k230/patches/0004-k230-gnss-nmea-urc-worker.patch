 /* If true, indicates that the NRF_MODEM_GNSS_EVT_AGNSS_REQ event
@@ -532,27 +541,67 @@
 #endif /* CONFIG_SM_NRF_CLOUD */
 
 #if defined(CONFIG_SM_LOG_LEVEL_DBG) || defined(CONFIG_SM_GNSS_NMEA_URC)
+static void gnss_nmea_urc_sender(struct k_work *work)
+{
+	ARG_UNUSED(work);
+#if defined(CONFIG_SM_GNSS_NMEA_URC)
+	struct gnss_nmea_urc_item *item;
+
+	while ((item = (struct gnss_nmea_urc_item *)k_fifo_get(&gnss_nmea_urc_fifo,
+							       K_NO_WAIT)) != NULL) {
+		if (gnss_nmea_urc_enabled && item->len > 0) {
+			urc_send_to(gnss_pipe, "\r\n#XGNSSNMEA: %.*s\r\n",
+				    (int)item->len, item->nmea);
+		}
+		k_free(item);
+	}
+#endif
+}
+
 static void on_gnss_evt_nmea(void)
 {
 	int err;
 	size_t len;
 	char *nmea_str;
+	char *end;
 	struct nrf_modem_gnss_nmea_data_frame nmea;
 
 	err = nrf_modem_gnss_read(&nmea, sizeof(nmea), NRF_MODEM_GNSS_DATA_NMEA);
 	if (err) {
 		LOG_ERR("Failed to read GNSS NMEA data. (%d)", err);
+		return;
 	}
 	nmea_str = nmea.nmea_str;
-	len = strlen(nmea_str);
+	end = memchr(nmea_str, '\0', sizeof(nmea.nmea_str));
+	if (!end) {
+		LOG_WRN("GNSS NMEA frame is not NUL terminated");
+		len = sizeof(nmea.nmea_str);
+	} else {
+		len = end - nmea_str;
+	}
+
+	while (len > 0 && (nmea_str[len - 1] == '\r' || nmea_str[len - 1] == '\n')) {
+		len--;
+	}
+	if (len == 0) {
+		LOG_WRN("GNSS NMEA frame is empty");
+		return;
+	}
 
-	assert(len >= 2);
-	len -= 2;
-	assert(!strcmp(nmea_str + len, "\r\n"));
-	LOG_DBG("%.*s", len, nmea_str);
+	LOG_DBG("%.*s", (int)len, nmea_str);
 #if defined(CONFIG_SM_GNSS_NMEA_URC)
 	if (gnss_nmea_urc_enabled) {
-		urc_send_to(gnss_pipe, "\r\n#XGNSSNMEA: %.*s\r\n", len, nmea_str);
+		struct gnss_nmea_urc_item *item = k_malloc(sizeof(*item));
+
+		if (!item) {
+			LOG_ERR("Failed to allocate GNSS NMEA URC item");
+			return;
+		}
+		memset(item, 0, sizeof(*item));
+		item->len = MIN(len, sizeof(item->nmea) - 1);
+		memcpy(item->nmea, nmea_str, item->len);
+		k_fifo_put(&gnss_nmea_urc_fifo, item);
+		k_work_submit_to_queue(&sm_work_q, &gnss_nmea_urc_send_work);
 	}
 #endif
 }
