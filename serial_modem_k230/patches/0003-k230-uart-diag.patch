+	size_t diag_len = len;
+
+	if (diag_len > 32) {
+		diag_len = 32;
+	}
+	LOG_HEXDUMP_WRN(buf, diag_len, prefix);
+	if (len > diag_len) {
+		LOG_WRN("%s truncated: total=%u shown=%u", prefix, (unsigned int)len, (unsigned int)diag_len);
+	}
+}
+#endif
